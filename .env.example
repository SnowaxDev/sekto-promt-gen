# --- required to actually generate + critique ---
REPLICATE_API_TOKEN=r8_xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# --- storage: leave MONGO_URI blank to use the local JSON store ---
MONGO_URI=
MONGO_DB=seknuto_forge

# --- models (override when Anthropic/Replicate ship newer ones) ---
IMAGE_MODEL=google/nano-banana-2
IMAGE_MODEL_TEXT=ideogram-ai/ideogram-v2
CRITIC_MODEL=claude-sonnet-5

# --- learning loop tuning ---
EXPLORE_EPSILON=0.15
DEFECT_PROMOTE_THRESHOLD=3
DEFECT_WINDOW=20
HUMAN_WEIGHT=0.7

# --- auto-refine loop (generate -> critique -> fix prompt -> regenerate) ---
# each iteration costs one Replicate render; keep the cap low to control cost
REFINE_MAX_ITERS=3
REFINE_TARGET_SCORE=88
